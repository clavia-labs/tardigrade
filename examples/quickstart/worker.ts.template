import { host } from "tardie/platform/cloudflare"
import definition, { notifyLayer } from "./actor"

const worker = host(definition, {
  layer: notifyLayer,
  http: (env: { readonly TARDIGRADE_TOKEN?: string }) => ({ ...(env.TARDIGRADE_TOKEN ? { token: env.TARDIGRADE_TOKEN } : {}) }),
})

export const ActorDO = worker.ActorObject
export const ThreadDO = worker.ThreadObject
export default { fetch: worker.fetch }
