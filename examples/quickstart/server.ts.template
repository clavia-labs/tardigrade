import { Context, Effect } from "effect"
import { createBunHost, methodHttp } from "tardie/platform/bun"
import definition, { notifyLayer } from "./actor"

const host = await Effect.runPromise(createBunHost({
  actor: definition,
  actorContext: Context.pick(),
  storage: process.env.TARDIGRADE_ACTOR_DATA ?? ".tardigrade",
  services: () => notifyLayer,
}))

const server = Bun.serve({
  hostname: "127.0.0.1",
  port: Number(process.env.PORT ?? 4242),
  idleTimeout: 0,
  fetch: methodHttp(host, { ...(process.env.TARDIGRADE_TOKEN ? { token: process.env.TARDIGRADE_TOKEN } : {}) }),
})
console.log(`Listening on ${server.url}`)

await new Promise<void>(resolve => {
  const stop = () => { process.off("SIGINT", stop); process.off("SIGTERM", stop); resolve() }
  process.once("SIGINT", stop)
  process.once("SIGTERM", stop)
})
await server.stop(true)
await Effect.runPromise(host.close)
