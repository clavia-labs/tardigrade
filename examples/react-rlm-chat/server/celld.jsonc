{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tardigrade-react-rlm-chat",
  "main": "worker.ts",
  "compatibility_date": "2026-09-04",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "ACTORS", "class_name": "ActorDO" },
      { "name": "THREADS", "class_name": "ThreadDO" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ActorDO", "ThreadDO"] }],
  "vars": {
    "TARDIGRADE_ALARM_DELAY_MILLIS": "120000",
    "TARDIGRADE_COMPACTION_FIRE_RATIO": "0.8",
    "TARDIGRADE_COMPACTION_KEEP_RATIO": "0.5",
    "TARDIGRADE_MAX_CONCURRENT_THREADS": "4",
    "TARDIGRADE_CONFIG": "{\"models\":{\"allow\":[{\"provider\":\"openrouter\",\"model_ids\":[\"openai/gpt-5.6-sol\"]}],\"default\":{\"provider\":\"openrouter\",\"model_id\":\"openai/gpt-5.6-sol\"}}}",
    "TARDIGRADE_SANDBOX_TRANSPORT": "replay",
    "TARDIGRADE_BACKGROUND_TASK_OWNER": "request"
  }
}
