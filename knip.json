{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreDependencies": [
    "tsdown",
    "@ai-sdk/gateway",
    "@ai-sdk/openai-compatible",
    "@ai-sdk/provider",
    "@types/json-schema",
    "@types/node"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "tools/*.ts"
      ],
      "project": [
        "tools/**/*.ts"
      ]
    },
    "packages/*": {
      "project": [
        "src/**/*.ts"
      ]
    }
  }
}
