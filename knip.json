{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "tools/*.ts",
        "examples/*.ts"
      ],
      "project": [
        "tools/**/*.ts",
        "examples/**/*.ts"
      ]
    },
    "packages/*": {
      "project": [
        "src/**/*.ts"
      ]
    },
    "platform/*": {
      "project": [
        "src/**/*.ts"
      ]
    },
    "apps/*": {
      "project": [
        "src/**/*.ts"
      ]
    },
    "apps/voyager": {
      "entry": [
        "src/api.ts",
        "src/nav.ts",
        "src/policy.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "dev/**/*.ts"
      ],
      "ignoreDependencies": [
        "@base-ui-components/react"
      ]
    }
  }
}
