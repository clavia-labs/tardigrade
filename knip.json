{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreDependencies": [
    "cloudflare",
    "@clavia/tardigrade-ui"
  ],
  "workspaces": {
    ".": {
      "ignoreDependencies": [
        "@effect/tsgo",
        "@effect/language-service"
      ],
      "entry": [
        "tools/*.ts",
        "examples/*/*.ts"
      ],
      "project": [
        "tools/**/*.ts",
        "examples/**/*.ts"
      ]
    },
    "e2e": {
      "project": [
        "**/*.ts"
      ]
    },
    "examples/react-rlm-chat/server": {
      "project": [
        "*.ts"
      ]
    },
    "examples/react-rlm-chat/web": {
      "project": [
        "src/**/*.{ts,tsx}!"
      ],
      "ignoreIssues": {
        "src/config.ts": [
          "exports"
        ]
      }
    },
    "platform/*": {
      "project": [
        "src/**/*.ts"
      ]
    },
    "platform/cloudflare": {
      "entry": [
        "test/fixture.worker.ts"
      ],
      "project": [
        "src/**/*.ts",
        "test/**/*.ts",
        "*.config.ts"
      ]
    },
    "platform/model": {
      "ignoreDependencies": [
        "@smithy/node-http-handler!"
      ]
    },
    "platform/worker-loader": {
      "entry": [
        "test/fixture.worker.ts",
        "test/celld/worker.ts"
      ],
      "project": [
        "src/**/*.ts",
        "test/**/*.ts",
        "*.config.ts"
      ]
    },
    "apps/*": {
      "project": [
        "src/**/*.{ts,tsx}"
      ]
    },
    "apps/cli": {
      "ignoreDependencies": [
        "@effect/platform-node-shared"
      ]
    },
    "apps/voyager": {
      "entry": [
        "src/client.ts",
        "src/nav.ts",
        "src/policy.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}!",
        "dev/**/*.ts"
      ]
    },
    "apps/web": {
      "entry": [
        "src/**/*.test.ts",
        "../../docs/**/*.mdx"
      ],
      "project": [
        "src/**/*.{ts,tsx}!",
        "../../docs/**/*.mdx"
      ]
    }
  }
}
