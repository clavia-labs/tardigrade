{
  "name": "@clavia/tardigrade-core",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "author": "Clavia, Inc.",
  "description": "Event, projection, component, actor, and runtime contracts for Tardigrade.",
  "homepage": "https://github.com/clavia-labs/tardigrade#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clavia-labs/tardigrade.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/clavia-labs/tardigrade/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "!src/**/*.test.ts"
  ],
  "engines": {
    "bun": ">=1.4.0"
  },
  "type": "module",
  "exports": {
    "./actor": "./src/actor/index.ts",
    "./actor/*": "./src/actor/*.ts",
    "./method": "./src/method/index.ts",
    "./method/*": "./src/method/*.ts",
    "./communication": "./src/communication/index.ts",
    "./communication/*": "./src/communication/*.ts",
    "./component": "./src/component/index.ts",
    "./component/*": "./src/component/*.ts",
    "./effect": "./src/effect.ts",
    "./event": "./src/event.ts",
    "./intent": "./src/intent.ts",
    "./log": "./src/log/index.ts",
    "./log/event": "./src/event.ts",
    "./log/*": "./src/log/*.ts",
    "./machine": "./src/machine.ts",
    "./projection": "./src/projection/projection.ts",
    "./projection/*": "./src/projection/*.ts",
    "./reconciliation": "./src/compatibility/reconciliation.ts",
    "./reconciliation/reconciler": "./src/compatibility/reconciler.ts",
    "./reconciliation/transition": "./src/compatibility/transition.ts",
    "./runtime": "./src/runtime/index.ts",
    "./runtime/*": "./src/runtime/*.ts",
    "./thread": "./src/thread/index.ts",
    "./thread/*": "./src/thread/*.ts",
    "./transition": "./src/transition/index.ts",
    "./transition/*": "./src/transition/*.ts",
    "./view": "./src/view.ts"
  },
  "dependencies": {
    "effect": "4.0.0-rc.110"
  },
  "devDependencies": {
    "fast-check": "^4.9.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  }
}
