{
  "name": "@clavia/tardigrade-core",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "author": "Clavia, Inc.",
  "description": "Event, log, actor, and reactor contracts for tardigrade.",
  "homepage": "https://github.com/clavia-labs/tardigrade#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clavia-labs/tardigrade.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/clavia-labs/tardigrade/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "!src/**/*.test.ts"
  ],
  "engines": {
    "bun": ">=1.4.0"
  },
  "type": "module",
  "exports": {
    "./actor": "./src/actor/index.ts",
    "./actor/*": "./src/actor/*.ts",
    "./actor/method": "./src/actor/method/index.ts",
    "./actor/method/*": "./src/actor/method/*.ts",
    "./communication": "./src/communication/index.ts",
    "./communication/*": "./src/communication/*.ts",
    "./log": "./src/log/index.ts",
    "./log/*": "./src/log/*.ts",
    "./reconciliation": "./src/reconciliation/index.ts",
    "./reconciliation/*": "./src/reconciliation/*.ts",
    "./thread": "./src/thread/index.ts",
    "./thread/*": "./src/thread/*.ts"
  },
  "dependencies": {
    "effect": "4.0.0-rc.110"
  },
  "devDependencies": {
    "fast-check": "^4.9.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  }
}
