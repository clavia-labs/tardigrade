{
  "name": "@clavia/tardigrade-model",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "author": "Clavia, Inc.",
  "description": "Effect AI inference binding for tardigrade.",
  "homepage": "https://github.com/clavia-labs/tardigrade#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clavia-labs/tardigrade.git",
    "directory": "packages/model"
  },
  "bugs": {
    "url": "https://github.com/clavia-labs/tardigrade/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/testing/**"
  ],
  "engines": {
    "bun": ">=1.4.0"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./catalog": "./src/catalog/index.ts",
    "./catalog-store": "./src/catalog/repository.ts",
    "./catalog-page": "./src/catalog/page.ts",
    "./catalog-availability": "./src/catalog/availability.ts",
    "./metadata": "./src/catalog/metadata.ts",
    "./directory": "./src/providers/directory.ts",
    "./reasoning": "./src/providers/options.ts",
    "./request-policy": "./src/inference/policy.ts",
    "./output": "./src/binding/output.ts",
    "./*": "./src/*.ts"
  },
  "dependencies": {
    "@clavia/tardigrade-agent": "workspace:*",
    "@clavia/tardigrade-client": "workspace:*",
    "@clavia/tardigrade-core": "workspace:*",
    "@tardie/ai-anthropic": "4.0.0-rc.113-clavia.1",
    "@tardie/ai-openai": "4.0.0-rc.113-clavia.2",
    "@tardie/ai-openai-compat": "4.0.0-rc.113-clavia.1",
    "@smithy/fetch-http-handler": "^5.6.3",
    "effect": "4.0.0-rc.115",
    "@tardie/ai": "0.0.2",
    "@aws-sdk/client-bedrock-runtime": "^3.1079.0",
    "@smithy/node-http-handler": "^4.11.2"
  },
  "devDependencies": {
    "fast-check": "^4.9.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  }
}
