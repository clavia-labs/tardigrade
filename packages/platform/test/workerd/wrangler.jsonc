{
  "name": "tardigrade-experimental-test",
  "main": "../fixtures/workerd/fixture.worker.ts",
  "compatibility_date": "2026-08-08",
  "durable_objects": {
    "bindings": [
      {
        "name": "EFFECT_SERVICE",
        "class_name": "EffectServiceDO"
      },
      {
        "name": "INPUT_LIFECYCLE",
        "class_name": "InputLifecycleDO"
      },
      {
        "name": "PROMISE_RESOLVER",
        "class_name": "TestPromiseResolver"
      },
      {
        "name": "ACTORS",
        "class_name": "LayoutActorDO"
      },
      {
        "name": "THREADS",
        "class_name": "LayoutThreadDO"
      },
      {
        "name": "RETRY_ACTORS",
        "class_name": "RetryActorDO"
      },
      {
        "name": "RETRY_THREADS",
        "class_name": "RetryThreadDO"
      },
      {
        "name": "SLOW_ACTORS",
        "class_name": "SlowActorDO"
      },
      {
        "name": "SLOW_THREADS",
        "class_name": "SlowThreadDO"
      },
      {
        "name": "CHECKPOINT_REGULAR_ACTORS",
        "class_name": "RegularCheckpointActorDO"
      },
      {
        "name": "CHECKPOINT_REGULAR_THREADS",
        "class_name": "RegularCheckpointThreadDO"
      },
      {
        "name": "CHECKPOINT_FAMILY_ACTORS",
        "class_name": "FamilyCheckpointActorDO"
      },
      {
        "name": "CHECKPOINT_FAMILY_THREADS",
        "class_name": "FamilyCheckpointThreadDO"
      },
      {
        "name": "CHECKPOINT_MIXED_ACTORS",
        "class_name": "MixedCheckpointActorDO"
      },
      {
        "name": "CHECKPOINT_MIXED_THREADS",
        "class_name": "MixedCheckpointThreadDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "EffectServiceDO",
        "InputLifecycleDO",
        "TestPromiseResolver",
        "LayoutActorDO",
        "LayoutThreadDO",
        "RetryActorDO",
        "RetryThreadDO",
        "SlowActorDO",
