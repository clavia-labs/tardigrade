{
  "name": "tardigrade-agent-content-test",
  "main": "agent-fixture.worker.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "r2_buckets": [{ "binding": "OBJECTS", "bucket_name": "tardigrade-agent-content-test" }],
  "durable_objects": { "bindings": [
    { "name": "ACTORS", "class_name": "AgentActorDO" },
    { "name": "THREADS", "class_name": "AgentThreadDO" }
  ] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AgentActorDO", "AgentThreadDO"] }]
}
