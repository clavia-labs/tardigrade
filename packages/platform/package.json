{
  "name": "@clavia/tardigrade-platform",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    "./bun": "./src/bun/index.ts",
    "./cloudflare": "./src/cloudflare/index.ts",
    "./journal": "./src/shared/sql-journal.ts"
  },
  "dependencies": {
    "@clavia/tardigrade-bun": "workspace:*",
    "@clavia/tardigrade-code": "workspace:*",
    "@clavia/tardigrade-cloudflare": "workspace:*",
    "@clavia/tardigrade-core": "workspace:*",
    "@clavia/tardigrade-worker-loader": "workspace:*",
    "@effect/sql-sqlite-bun": "4.0.0-rc.115",
    "@effect/sql-sqlite-do": "4.0.0-rc.115",
    "@effect/platform-bun": "4.0.0-rc.115",
    "effect": "4.0.0-rc.115"
  },
  "devDependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@cloudflare/workers-types": "^5.20260804.1",
    "@cloudflare/vitest-plugin": "^1.4.1",
    "fast-check": "^4.9.0",
    "vitest": "^5.0.4",
    "workerd": "1.20261006.1",
    "@clavia/tardigrade-agent": "workspace:*",
    "@clavia/tardigrade-libraries": "workspace:*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test test/bun",
    "test:workers": "vitest run --config vitest.config.ts && vitest run --config vitest.agent.config.ts",
    "test:workers:long": "TARDIGRADE_TEST_LONG=1 vitest run --config vitest.config.ts",
    "test:deployed": "bun run test/deployed.ts"
  }
}
