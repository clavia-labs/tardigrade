{
  "name": "@clavia/tardigrade-agent",
  "version": "0.0.1",
  "license": "MIT",
  "author": "Clavia, Inc.",
  "description": "A durable agent harness. State is a pure function of the log.",
  "homepage": "https://github.com/clavia-labs/tardigrade#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clavia-labs/tardigrade.git",
    "directory": "packages/agent"
  },
  "bugs": {
    "url": "https://github.com/clavia-labs/tardigrade/issues"
  },
  "files": [
    "src",
    "!src/**/*.test.ts"
  ],
  "engines": {
    "bun": ">=1.4.0"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./actor/*": "./src/actor/*.ts",
    "./component/*": "./src/component/*.ts",
    "./inference/*": "./src/inference/*.ts",
    "./log/*": "./src/log/*.ts",
    "./output/*": "./src/output/*.ts",
    "./packages/*": "./src/packages/*.ts",
    "./projection/*": "./src/projection/*.ts",
    "./runtime/*": "./src/runtime/*.ts"
  },
  "dependencies": {
    "@clavia/tardigrade-core": "workspace:*",
    "@clavia/tardigrade-code": "workspace:*",
    "@cfworker/json-schema": "^4.1.1",
    "effect": "npm:@tardie/effect@4.0.0-rc.113"
  },
  "devDependencies": {
    "fast-check": "^4.9.0",
    "@clavia/tardigrade-host": "workspace:*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "private": true
}
