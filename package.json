{
  "name": "tardigrade",
  "version": "0.10.1",
  "type": "module",
  "engines": {
    "bun": ">=1.4.0"
  },
  "workspaces": [
    "packages/*",
    "platform/*",
    "apps/*",
    "e2e"
  ],
  "scripts": {
    "tdg": "bun run apps/cli/src/main.ts",
    "cli:build": "bun run pack",
    "cli:check": "bun run gate --only=lint:effect:apps:cli,typecheck:app-cli,test:app-cli",
    "gate": "bun run tools/gate.ts",
    "e2e": "bun test e2e",
    "lint": "oxlint",
    "lint:effect": "bun run gate --only=lint:effect",
    "tla": "bun run tools/tla.ts",
    "typecheck": "tsc --noEmit && bun run --filter './packages/*' typecheck",
    "test": "bun run --filter './packages/*' test",
    "web": "bun run --cwd apps/web dev",
    "knip": "knip --no-progress --treat-config-hints-as-errors --treat-tag-hints-as-errors",
    "setup": "git config core.hooksPath .githooks",
    "pack": "bun run tools/publish.ts --dry-run"
  },
  "dependencies": {
    "@types/node": "^24",
    "typescript": "7.0.2"
  },
  "devDependencies": {
    "@effect/tsgo": "0.36.5",
    "@types/bun": "^1.3.4",
    "beautiful-mermaid": "^1.1.3",
    "knip": "^6.15.0",
    "oxlint": "^1.69.0"
  },
  "private": true
}
